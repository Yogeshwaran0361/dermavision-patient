rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile rule: Users can read and write only their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User scans rule: Users can read and write only their own scan subcollection
      match /scans/{scanId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Consultations rule
    match /consultations/{consultationId} {
      allow read, write: if request.auth != null;

      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // Notifications rule: Patients can read ONLY notifications sent to their Firebase UID
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.patientUid == request.auth.uid;
      allow write: if request.auth != null;
    }
  }
}
